#!/usr/bin/env bash
set -euo pipefail
REPO_DIR="/var/lib/containers/storage/volumes/srv-www/_data/htdocs/pub/ptf_repo/mls7"
CHANNEL_LABEL="custom-ptf-mls7_ltss-x86_64"
LOG_FILE="/var/log/ptf-sync-automation.log"
exec >> "${LOG_FILE}" 2>&1
echo "=== Starting PTF sync at $(date) ==="
if [ -d "${REPO_DIR}" ]; then
createrepo_c --update "${REPO_DIR}"
else
echo "ERROR: Directory ${REPO_DIR} not found!" >&2 && exit 1
fi
echo "Triggering spacewalk-repo-sync for channel: ${CHANNEL_LABEL}..."
if command -v mgrctl >/dev/null 2>&1; then
mgrctl exec -- spacewalk-repo-sync --channel "${CHANNEL_LABEL}" --type yum else
spacewalk-repo-sync --channel "${CHANNEL_LABEL}" --type yum
fi
echo "=== Sync completed successfully at $(date) ==="
4. Inotify Debounce Watcher & Service
Script path: /usr/local/bin/watch_ptf_repo.sh (debounces downloads by 120s of sustained inactivity):
#!/usr/bin/env bash
set -euo pipefail
REPO_DIR="/var/lib/containers/storage/volumes/srv-www/_data/htdocs/pub/ptf_repo/mls7"
SYNC_SCRIPT="/usr/local/bin/sync-ptf-repo.sh"
TIMEOUT_SECS=120
echo "Watching ${REPO_DIR} for RPM changes..."
while true; do
inotifywait -q -e close_write,moved_to "${REPO_DIR}" >/dev/null 2>&1
echo "Activity detected. Debouncing for ${TIMEOUT_SECS} seconds..."
while true; do
if inotifywait -q -t "${TIMEOUT_SECS}" -e close_write,moved_to "${REPO_DIR}" >/dev/null 2>&1; then
echo "Additional file incoming. Resetting timer..."
else
break
fi
done
echo "Quiet window reached. Executing repository sync..."
"${SYNC_SCRIPT}"
done
