[Unit]
Description=PTF RPM Inotify Debounce Watcher and MLM Sync
After=network.target local-fs.target
Wants=local-fs.target
[Service]
Type=simple
ExecStart=/usr/local/bin/watch_ptf_repo.sh
Restart=always
RestartSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
systemctl daemon-reload && systemctl enable --now ptf-watcher.service
5. Interactive PTF Batch Downloader
Script path: /usr/local/bin/download_ptfs.sh . Securely accepts credentials and extracts RPM payloads:
#!/usr/bin/env bash
set -euo pipefail
TARGET_DIR="/var/lib/containers/storage/volumes/srv-www/_data/htdocs/pub/ptf_repo/mls7"
read -rp "Enter PTF portal username: " PTF_USER
read -rsp "Enter PTF portal password: " PTF_PASS; echo ""
read -rp "Enter PTF download URL: " URL
[[ "${URL}" != */ ]] && URL="${URL}/"
mkdir -p "${TARGET_DIR}" && cd "${TARGET_DIR}"
echo "Fetching package index from ${URL}..."
curl -s -u "${PTF_USER}:${PTF_PASS}" "${URL}" | \
grep -o 'href="[^"]*\.rpm"' | cut -d'"' -f2 | \
while read -r file; do
echo "Downloading ${file}..."
curl -f -u "${PTF_USER}:${PTF_PASS}" -O "${URL}${file}"
done
echo "Download complete. RPMs deposited in ${TARGET_DIR}."
